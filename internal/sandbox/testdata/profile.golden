(version 1)
(deny default)
(allow file-read*)
(allow process-exec)
(allow process-fork)
(allow sysctl-read)
(allow signal (target self))
(deny network*)
(allow file-write* (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/dtracehelper"))
(allow file-write*
  (subpath "/Users/dev/Library/Caches/go-build")
  (subpath "/Users/dev/go/pkg/mod")
  (subpath "/Users/dev/project")
)
